# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.claude/
CLAUDE.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the .example file is intentionally tracked, see below)
.env*
!.env.local.example

# vercel
.vercel

# sitemap
/public/sitemap*.xml
/public/robots.txt

# typescript
*.tsbuildinfo
next-env.d.ts
